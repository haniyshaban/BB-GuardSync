<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config for Black Belt Guard App.
    - Enforces HTTPS for all traffic in release builds (no cleartext allowed).
    - Capacitor sets androidScheme: 'https' in capacitor.config.ts, so the
      local WebView content is already served over https://.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
