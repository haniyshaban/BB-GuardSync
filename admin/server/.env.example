# Server port
PORT=5000

# JWT secret - CHANGE THIS to a long random string in production!
JWT_SECRET=change-this-to-a-long-random-secret

# Node environment
NODE_ENV=production

# CORS - comma-separated list of allowed browser origins (no trailing slashes)
# REQUIRED in production - update whenever you deploy a new frontend URL
ALLOWED_ORIGINS=https://bb-guard-sync.vercel.app,https://bb-guardsync-admin.vercel.app,https://bb-staff-sync.vercel.app,capacitor://localhost,https://localhost
