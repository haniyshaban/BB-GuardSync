# Server
PORT=5000
# REQUIRED in production: unique random string, >= 32 chars. The server refuses
# to start in production with a missing/default/short secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-this-to-a-random-secret-in-production
NODE_ENV=development

# Statutory PII encryption (Aadhaar/PAN/EPF/bank numbers) at rest, AES-256-GCM.
# Optional: a 32-byte key as hex-64 or base64. If unset, a key is derived from
# JWT_SECRET. Set this explicitly in production so rotating JWT_SECRET does not
# make stored PII undecryptable. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PII_ENCRYPTION_KEY=

# Admin Frontend
VITE_API_URL=http://localhost:5000/api

# Default admin credentials (used by seed.js)
# In production, leave ADMIN_PASSWORD unset to have a strong random password
# generated and printed once to the boot log (the 'admin123' default is dev-only).
ADMIN_EMAIL=admin@blackbelt.app
ADMIN_PASSWORD=admin123
